# Load this file inside nginx's http context before the site server block.
# It emits only coarse route names, never raw paths, query strings, referers,
# Authorization/Cookie headers, Emby item IDs, or subtitle candidate IDs.
map $uri $subbridge_route {
    default                                      other;
    /                                            ui;
    ~^/assets/                                   ui_assets;
    /livez                                       livez;
    /readyz                                      readyz;
    /v1/health                                   health;
    /v1/auth/login                                auth_login;
    /v1/emby/libraries                           libraries;
    /v1/emby/items                               items;
    ~^/v1/media/[^/]+/subtitles/search$          subtitle_search;
    ~^/v1/media/[^/]+/subtitles/fetch$           subtitle_fetch;
    ~^/v1/media/[^/]+/subtitles/preview$         subtitle_preview;
    ~^/v1/media/[^/]+/subtitles/upload$          subtitle_upload;
    ~^/v1/media/[^/]+/subtitles/add$             subtitle_add;
    ~^/v1/media/[^/]+/subtitles/[^/]+/replace$   subtitle_replace;
    ~^/v1/media/[^/]+/subtitles/[^/]+/delete$    subtitle_delete;
    /v1/subtitle-operations                      subtitle_history;
    ~^/v1/subtitle-operations/[^/]+/restore$     subtitle_restore;
    ~^/v1/media/[^/]+/subtitles$                 media_subtitles;
    ~^/v1/media/[^/]+$                           media;
}

log_format subbridge_safe
    '$remote_addr [$time_local] "$request_method $server_protocol" '
    'route=$subbridge_route status=$status bytes=$body_bytes_sent '
    'request_time=$request_time';
